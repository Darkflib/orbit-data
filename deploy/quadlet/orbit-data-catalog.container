[Unit]
Description=Refresh Orbit enrichment catalogue
After=network-online.target
Wants=network-online.target
OnFailure=orbit-data-alert@%n.service

[Container]
Image=ghcr.io/darkflib/orbit-data:latest
Pull=newer
Exec=--config /etc/orbit-data.toml sync-catalog
Volume=/srv/orbit-data:/data:rw
Network=orbit-egress.network
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
User=10001
Group=10001
# See orbit-data-gp.container: podman's journald driver duplicates every line
# systemd already captures from the container's stdout.
LogDriver=none
PidsLimit=128

[Service]
Type=oneshot
MemoryMax=768M
TimeoutStartSec=30m
