[Unit]
Description=Check Orbit data freshness and free space
# Wire alerting here: any unit you drop in receives the failure. Only a
# critical check fails this service; warnings stay in the journal.
# OnFailure=orbit-data-alert@%n.service

[Container]
Image=ghcr.io/darkflib/orbit-data:latest
# Deliberately NOT Pull=newer, unlike the updaters. A monitor that starts by
# contacting GHCR fails whenever GHCR is unreachable, which produces an alert
# about the registry rather than about the data — and, worse, no alert at all
# about data that really has gone stale. The updaters keep the local image
# current; this job just uses whatever they left behind.
Pull=missing
Exec=--config /etc/orbit-data.toml check-health
# Read-only: this job must never be able to repair, rotate, or truncate the
# tree it is judging.
Volume=/srv/orbit-data:/data:ro
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
User=10001
Group=10001
LogDriver=none
PidsLimit=128

[Service]
Type=oneshot
MemoryMax=128M
TimeoutStartSec=5m
