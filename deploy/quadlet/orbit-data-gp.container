[Unit]
Description=Refresh Orbit CelesTrak OMM cache
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/darkflib/orbit-data:latest
Pull=newer
Exec=--config /etc/orbit-data.toml sync-gp
Volume=/srv/orbit-data:/data:rw
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
User=10001
Group=10001
LogDriver=journald
PidsLimit=128
Memory=512M

[Service]
Type=oneshot
TimeoutStartSec=30m
