[Unit]
Description=Refresh Orbit CelesTrak OMM cache
After=network-online.target
Wants=network-online.target
OnFailure=orbit-data-alert@%n.service

[Container]
Image=ghcr.io/darkflib/orbit-data:latest
Pull=newer
Exec=--config /etc/orbit-data.toml sync-gp
Volume=/srv/orbit-data:/data:rw
Network=orbit-egress.network
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
User=10001
Group=10001
# The oneshot updaters log structured JSON to stdout, which systemd already
# captures from the podman process into the journal under this unit. Podman's
# own journald driver writes a second copy of every line, so each run appears
# twice. Suppress the driver and keep systemd's capture, which is the copy that
# carries the right unit metadata.
LogDriver=none
PidsLimit=128

[Service]
Type=oneshot
MemoryMax=512M
TimeoutStartSec=30m
