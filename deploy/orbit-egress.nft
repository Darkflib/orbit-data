table ip orbit_egress {
    chain postrouting {
        type nat hook postrouting priority srcnat - 10; policy accept;

        ip saddr 10.89.60.0/24 oifname "ens3" \
            counter \
            snat to 999.999.999.999 \
            comment "Orbit containers egress via 198.98.60.239"
    }
}

